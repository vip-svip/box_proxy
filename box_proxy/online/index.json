{
  "name": "Box Proxy 在线资源索引",
  "description": "WebUI 的『在线导入』可直接填入下列任一地址进行导入。",
  "core": {
    "mihomo_release": "https://github.com/MetaCubeX/mihomo/releases",
    "version": "v1.18.8",
    "mirrors": [
      "https://ghfast.top/",
      "https://gh-proxy.com/",
      "https://ghproxy.net/"
    ]
  },
  "sources": [
    {
      "id": "custom",
      "name": "自定义在线地址",
      "type": "clash-yaml",
      "url": "https://example.com/your-subscription.yaml",
      "note": "填入你自己的订阅地址，支持 Clash/mihomo YAML 订阅"
    },
    {
      "id": "geox",
      "name": "GeoIP / GeoSite 数据库",
      "type": "geo",
      "url": "https://github.com/MetaCubeX/meta-rules-dat/releases/download/latest/geoip.dat"
    }
  ],
  "modules": [
    {
      "id": "adblock",
      "name": "广告拦截规则集",
      "type": "rule-provider",
      "url": "https://raw.githubusercontent.com/yourname/box-proxy/main/online/modules/adblock.yaml"
    },
    {
      "id": "global-direct",
      "name": "国内直连规则集",
      "type": "rule-provider",
      "url": "https://raw.githubusercontent.com/yourname/box-proxy/main/online/modules/cn-direct.yaml"
    }
  ]
}
